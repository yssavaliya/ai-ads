# LLM providers (free tiers only)
# Primary: Groq — get a key at https://console.groq.com
#   Current free-tier models: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback: Google Gemini — get a key at https://aistudio.google.com
#   Current free-tier models: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Extra FREE fallbacks, tried in LLM_PROVIDER_ORDER when Groq/Gemini hit limits or fail.
# Every key is optional; only configured providers take part.
LLM_PROVIDER_ORDER=groq,gemini,github,cerebras,openrouter,mistral,huggingface,pollinations
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-latest
# Run `python scripts/list_models.py` (or the Drift Check workflow) to see what your keys can use
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# GitHub Models (opt-in; uses GITHUB_TOKEN, in Actions: permissions: models: read)
GITHUB_MODELS_ENABLED=false
# Keyless public endpoint as a last resort (prompts leave to a third party): set false to disable
LLM_KEYLESS_FALLBACK=false

# Image providers (free tiers) and the guaranteed local branded-card fallback
IMAGE_PROVIDER_ORDER=pollinations,gemini,huggingface,together,cloudflare
IMAGE_CARD_FALLBACK=true
HF_TOKEN=
TOGETHER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Apify (free tier 1000 req/mo: https://console.apify.com)
APIFY_TOKEN=

# Delivery: site (default, static website on GitHub Pages) | email | both
DELIVERY_MODE=site
SITE_RETENTION_DAYS=45
# Optional: unguessable page URLs + unlisted index (Pages sites are public)
SITE_SECRET=

# Feedback links: HMAC key + comma-separated GitHub logins allowed to give feedback (both required)
FEEDBACK_SIGNING_KEY=
FEEDBACK_ALLOWED_USERS=
# Referenced from data/*.json as env:OWNER_EMAIL / env:DIGEST_EMAIL (keeps addresses out of git)
# OWNER_EMAIL=
# DIGEST_EMAIL=
# flag (publish with a "review" badge) | block (publish nothing under the bar)
BELOW_THRESHOLD_POLICY=flag

# Concurrency caps (1 = sequential)
LLM_CONCURRENCY=2
IMAGE_CONCURRENCY=3
FETCH_CONCURRENCY=2

# Gmail SMTP — only needed for DELIVERY_MODE=email|both (use App Password with 2FA enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# GitHub (for feedback issues + degraded-run tracking via API)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Dry run: write rendered emails/assets to logs/preview/ instead of sending
DRY_RUN=false

# Scheduling (UTC)
DAILY_CRON=29 18 * * *
WEEKLY_CRON=0 2 * * 0
FEEDBACK_CRON=0 * * * *

# Optional: comma-separated GitHub logins whose feedback issues count (unset = anyone)
FEEDBACK_ALLOWED_USERS=

# Lead discovery wall-clock budget (seconds)
LEAD_TIME_BUDGET_SECONDS=2100

# Virality
VIRALITY_THRESHOLD=75
MAX_REGENERATION_ATTEMPTS=5

# Logging
LOG_LEVEL=INFO
