# LLM providers (free tiers only)
# Primary: Groq — get a key at https://console.groq.com
#   Current free-tier models: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback: Google Gemini — get a key at https://aistudio.google.com
#   Current free-tier models: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional image fallback via Hugging Face Inference API (FLUX.1-schnell)
HF_TOKEN=

# Apify (free tier 1000 req/mo: https://console.apify.com)
APIFY_TOKEN=

# Gmail SMTP (use App Password with 2FA enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# GitHub (for feedback issues + degraded-run tracking via API)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Dry run: write rendered emails/assets to logs/preview/ instead of sending
DRY_RUN=false

# Scheduling (UTC)
DAILY_CRON=29 18 * * *
WEEKLY_CRON=0 2 * * 0
FEEDBACK_CRON=0 * * * *

# Optional: comma-separated GitHub logins whose feedback issues count (unset = anyone)
FEEDBACK_ALLOWED_USERS=

# Lead discovery wall-clock budget (seconds)
LEAD_TIME_BUDGET_SECONDS=2100

# Virality
VIRALITY_THRESHOLD=75
MAX_REGENERATION_ATTEMPTS=5

# Logging
LOG_LEVEL=INFO
