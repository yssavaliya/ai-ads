# LLM (OpenCode CLI - no key needed, uses free gateway)
OPENCODE_COMMAND=opencode
OPENCODE_TIMEOUT_SECONDS=300

# Groq fallback (free tier: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Gemini fallback (free tier: https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Apify (free tier 1000 req/mo: https://console.apify.com)
APIFY_TOKEN=

# Gmail SMTP (use App Password with 2FA enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# GitHub (for feedback issues via API)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Scheduling (UTC)
DAILY_CRON=29 18 * * *
WEEKLY_CRON=0 2 * * 0
FEEDBACK_CRON=0 * * * *

# Virality
VIRALITY_THRESHOLD=75
MAX_REGENERATION_ATTEMPTS=5

# Logging
LOG_LEVEL=INFO